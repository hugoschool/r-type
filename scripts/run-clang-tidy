#!/usr/bin/env bash

set -euo pipefail

source $(realpath $(dirname "$0"))/common-clang.sh

if ! command -v clang-tidy >/dev/null 2>&1; then
    echo "clang-tidy could not be found"
    exit 1
fi

BUILD_FOLDER=$BASE_DIR/build

echo "Processing client"
clang-tidy $CLIENT_FILES -p $BUILD_FOLDER --exclude-header-filter=".*build.*" --warnings-as-errors="*" || exit 1

echo "Processing common"
clang-tidy $COMMON_FILES -p $BUILD_FOLDER --exclude-header-filter=".*build.*" --warnings-as-errors="*" || exit 1

echo "Processing engine"
clang-tidy $ENGINE_FILES -p $BUILD_FOLDER --exclude-header-filter=".*build.*" --warnings-as-errors="*" || exit 1

echo "Processing server"
clang-tidy $SERVER_FILES -p $BUILD_FOLDER --exclude-header-filter=".*build.*" --warnings-as-errors="*" || exit 1

echo "Processing network"
clang-tidy $NETWORK_FILES -p $BUILD_FOLDER --exclude-header-filter=".*build.*" --warnings-as-errors="*" || exit 1
